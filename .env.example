# Leave the Firebase values empty to run in DEMO mode (local data, simulated payments & notifications).

# Firebase web app config (Firebase console → Project settings → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Razorpay key id (public). The key secret is not used anywhere in this app.
VITE_RAZORPAY_KEY_ID=

# Comma-separated admin emails (UI only — real access is the Firestore `admins` collection)
VITE_ADMIN_EMAILS=

# Receives "new booking" emails. Must also exist as a document in the Firestore `admins` collection.
VITE_ADMIN_NOTIFY_EMAIL=

# Public site URL, used in links inside emails/WhatsApp
VITE_APP_URL=https://aaina.in

# Shown in the footer
VITE_SUPPORT_WHATSAPP=+91 90000 00000
VITE_SUPPORT_EMAIL=care@aaina.in
