rules_version = '2';
// Clients may only READ. Every write goes through Cloud Functions (functions/src/index.ts),
// which validate prices, slots and payments server-side.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    match /bookings/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;
    }
    // Slot docs reveal only date/time/status, used to grey out taken slots.
    match /slots/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /outbox/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // Admin access: create a document with the admin's email as its ID in the Firebase console.
    match /admins/{email} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
